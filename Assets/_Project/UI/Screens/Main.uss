.root {
    flex-grow: 1;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------------------------------------------------------------- menu */
.menu-screen {
    background-color: rgba(4, 5, 6, 0.55);
    align-items: flex-start;
    justify-content: center;
    padding-left: 110px;
}

.title {
    font-size: var(--font-xl);
    color: var(--color-accent);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.subtitle {
    color: var(--color-text-dim);
    margin-bottom: var(--space-lg);
}

.menu-panel {
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-panel-line);
    padding: var(--space-md) var(--space-lg);
    width: 560px;
}

.section-label {
    color: var(--color-accent);
    font-size: var(--font-sm);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
}

.row {
    flex-direction: row;
    align-items: center;
}

.row > .unity-button {
    margin-left: var(--space-xs);
}

.grow {
    flex-grow: 1;
}

.status {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
    margin-top: var(--space-md);
    white-space: normal;
    min-height: 40px;
}

.help {
    color: var(--color-text-dim);
    font-size: var(--font-sm);
    white-space: normal;
    margin-top: var(--space-sm);
}

.panel-title {
    font-size: var(--font-lg);
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
}

/* ---------------------------------------------------------------- hud */
.hud {
    align-items: center;
    justify-content: center;
}

.crosshair {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(230, 230, 230, 0.55);
}

.hold-ring {
    position: absolute;
    width: 34px;
    height: 34px;
}

.prompt {
    position: absolute;
    top: 56%;
    color: var(--color-text);
    font-size: var(--font-md);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 3px 10px;
}

.radio-indicator {
    position: absolute;
    left: 28px;
    bottom: 24px;
    font-size: var(--font-sm);
    color: var(--color-text-dim);
}

.radio-indicator.tx {
    color: var(--color-danger);
}

.radio-indicator.rx {
    color: var(--color-accent);
}

.lobby-info {
    position: absolute;
    left: 24px;
    top: 20px;
    background-color: rgba(10, 11, 12, 0.72);
    border-width: 1px;
    border-color: var(--color-panel-line);
    padding: var(--space-sm) var(--space-md);
}

.lobby-info > .unity-label {
    font-size: var(--font-sm);
    margin: 1px 0;
}

.lobby-code {
    color: var(--color-accent);
    font-size: var(--font-lg);
}

.black-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

.vanish-text {
    color: rgb(90, 90, 90);
    font-size: var(--font-md);
}

.toast {
    position: absolute;
    bottom: 90px;
    font-size: var(--font-md);
    color: var(--color-text);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 12px;
}

/* ---------------------------------------------------------------- pause */
.pause-screen {
    background-color: rgba(0, 0, 0, 0.62);
    align-items: center;
    justify-content: center;
}

.pause-screen .unity-slider {
    margin: 4px 0;
}
